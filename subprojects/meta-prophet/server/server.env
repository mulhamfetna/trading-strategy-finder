# Remote training server — connection + path config (NO SECRETS; key-based auth).
# Loaded by lib.sh. Safe to commit (the password lives only in the git-ignored
# SERVER_DATA.env at the repo root and is no longer needed once the key is installed).

# --- connection ---
SRV_HOST="78.89.209.212"     # KW public IP (LAN-private 192.168.50.62 is not reachable off-LAN)
SRV_PORT="33362"
SRV_USER="dev"
SRV_KEY="$HOME/.ssh/amd_trading"   # dedicated automation key (no passphrase)
SRV_ALIAS="amd-trading"            # matches ~/.ssh/config Host entry (convenience)

# --- remote layout (all under the user-owned scratch root; dev is NOT root) ---
REMOTE_ROOT="/home/dev/Mulham/meta-prophet"   # our isolated scratch
REMOTE_DATA="$REMOTE_ROOT/data"               # synced input CSVs (resident, reused across runs)
REMOTE_CODE="$REMOTE_ROOT/code"               # synced training scripts (source-of-truth is local)
REMOTE_RUNS="$REMOTE_ROOT/runs"               # per-run outputs (models, metrics, predictions)
REMOTE_LOGS="$REMOTE_ROOT/logs"               # per-run training logs
REMOTE_VENV="/home/dev/Mulham/.venv"          # reusable venv (already has torch 2.5.1+rocm6.2)

# --- GPU (forced) ---
# RX 6700 XT = gfx1031, not officially ROCm-supported -> force the gfx1030 codepath.
export HSA_OVERRIDE_GFX_VERSION="10.3.0"
GPU_ENV="HSA_OVERRIDE_GFX_VERSION=10.3.0 PYTORCH_HIP_ALLOC_CONF=garbage_collection_threshold:0.8"

# --- resource policy (shared box: 32 threads, ~123GB free, 20 containers) ---
# "Aggressive" per user choice: use most threads when our jobs run.
THREADS="30"
THREAD_ENV="OMP_NUM_THREADS=$THREADS MKL_NUM_THREADS=$THREADS OPENBLAS_NUM_THREADS=$THREADS NUMEXPR_NUM_THREADS=$THREADS"

# --- local layout ---
LOCAL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"   # subprojects/meta-prophet
LOCAL_RUNS="$LOCAL_ROOT/server_runs"     # mirrored run outputs land here (git-ignored CSVs)
LOCAL_LOGS="$LOCAL_ROOT/server_runs/logs"
