# Remote training server — connection + path config. COPY to `server.env` and fill in your values.
# `server.env` itself is git-ignored (it carries the host/port/user for a private box). Key-based auth:
# the SSH private key is NOT stored here (only its path); no password lives in this file.

# --- connection (fill these in) ---
SRV_HOST="<server-ip-or-host>"        # public IP / hostname reachable from where you run this
SRV_PORT="22"                          # SSH port
SRV_USER="<user>"                      # remote user (NOT root)
SRV_KEY="$HOME/.ssh/<your_key>"        # path to the dedicated automation key (no passphrase)
SRV_ALIAS="<ssh-config-host-alias>"    # optional: matches a ~/.ssh/config Host entry

# --- remote layout (all under the user-owned scratch root) ---
REMOTE_ROOT="/home/<user>/<scratch>/meta-prophet"
REMOTE_DATA="$REMOTE_ROOT/data"
REMOTE_CODE="$REMOTE_ROOT/code"
REMOTE_RUNS="$REMOTE_ROOT/runs"
REMOTE_LOGS="$REMOTE_ROOT/logs"
REMOTE_VENV="/home/<user>/<scratch>/.venv"   # reusable venv (torch/rocm etc.)

# --- GPU (forced; adjust to your card) ---
export HSA_OVERRIDE_GFX_VERSION="10.3.0"
GPU_ENV="HSA_OVERRIDE_GFX_VERSION=10.3.0 PYTORCH_HIP_ALLOC_CONF=garbage_collection_threshold:0.8"

# --- resource policy ---
THREADS="30"
THREAD_ENV="OMP_NUM_THREADS=$THREADS MKL_NUM_THREADS=$THREADS OPENBLAS_NUM_THREADS=$THREADS NUMEXPR_NUM_THREADS=$THREADS"

# --- local layout ---
LOCAL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOCAL_RUNS="$LOCAL_ROOT/server_runs"
LOCAL_LOGS="$LOCAL_ROOT/server_runs/logs"
